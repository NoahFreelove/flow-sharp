<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Flow.Studio.Host</AssemblyName>
    <RootNamespace>Flow.Studio.Host</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <FlowTarget Condition="'$(FlowTarget)' == ''">Desktop</FlowTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FlowTarget)' == 'Web'">
    <DefineConstants>$(DefineConstants);FLOW_WEB</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="flow-lang.Tests" />
    <ProjectReference Include="../flow-studio-engine/flow-studio-engine.csproj" />
    <ProjectReference Include="../flow-platform-linux/flow-platform-linux.csproj" />
    <ProjectReference Include="../flow-lang/flow-lang.csproj" />
  </ItemGroup>
</Project>
