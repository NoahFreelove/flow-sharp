use "@std"

Note: DX-05 slice — Array overload (silent clamping per D-01)
Int[] arr = [1, 2, 3, 4, 5]
Int[] mid = (slice arr 1 4)
Int negFive = (sub 0 5)
Int[] neg = (slice arr negFive 2)
Int[] over = (slice arr 3 100)
Int[] emp = (slice arr 3 2)

(print (str (len mid)))
(print (str (len neg)))
(print (str (len over)))
(print (str (len emp)))

