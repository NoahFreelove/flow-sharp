use "@std"
use "@audio"

tempo 120 {
    timesig 4/4 {
        key Cmajor {
            live 1bar {
                section main {
                    Sequence melody = | C4q D4q E4q F4q |
                }
                Song song = [main]
                Buffer result = (renderSong song "piano")
                (print "rendered live block once")
            }
        }
    }
}

(print "PASS: live hello smoke ran")
