use "@std"
use "@audio"

tempo 120 {
    timesig 4/4 {
        key Cmajor {
            live 1bar {
                section drums {
                    Sequence kick = | C2q _ C2q _ |
                }
                Song song = [drums]
                Buffer result = (renderSong song "drums")
                (print "drums block ran")
            }

            live 2bar {
                section pad {
                    Sequence chord_pad = | C3w | F3w |
                }
                Song song = [pad]
                Buffer result = (renderSong song "strings")
                (print "pad block ran")
            }
        }
    }
}

(print "PASS: multi-block live registration")
