use "@std"

Note: Test basic while loop
Int count = 0
while (lt count 5) {
  count = count + 1
}
(print (str count))
Note: Expected: 5

Note: Test while with condition variable
Int val2 = 0
Bool isRunning = true
while isRunning {
  val2 = val2 + 1
  isRunning = (lt val2 3)
}
(print (str val2))
Note: Expected: 3

Note: Test while false (never enters)
Int never = 0
while false {
  never = 99
}
(print (str never))
Note: Expected: 0

Note: Test while loop countdown
Int countdown = 10
while (gt countdown 0) {
  countdown = countdown - 1
}
(print (str countdown))
Note: Expected: 0

Note: Test unconditional break
Int bv = 0
while true {
  bv = 1
  break
}
(print (str bv))
Note: Expected: 1

Note: Test continue skips rest of body
Int ctest = 0
Int ci = 0
while (lt ci 3) {
  ci = ci + 1
  continue
  ctest = ctest + 1
}
(print (str ctest))
Note: Expected: 0
(print (str ci))
Note: Expected: 3
