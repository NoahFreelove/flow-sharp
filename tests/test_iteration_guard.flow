use "@std"

Note: Test that iteration guard stops a runaway loop
Note: Default limit is 10000
Int counter = 0
while true {
  counter = (add counter 1)
}
Note: Should hit iteration limit and report error, not hang
(print (str counter))
Note: Expected: 10000

Note: Test setMaxIterations
(setMaxIterations 100)
Int counter2 = 0
while true {
  counter2 = (add counter2 1)
}
(print (str counter2))
Note: Expected: 100
