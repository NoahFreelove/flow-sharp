use "@std"
use "@audio"

tempo 120 {
  timesig 4/4 {
    section intro {
      | C4 D4 E4 F4 |
    }
  }
}

Song song = [intro]

Note: Render the song - if bare expression was captured, we get audio
Note: If not captured, renderSong produces 0-frame buffer
Buffer rendered = (renderSong song "piano")
(print "render completed")

Note: Export to verify non-empty buffer - file should be > 44 bytes (WAV header)
(exportWav rendered "/tmp/test_bare_expr_output.wav")
(print "export completed")

(print "test_section_bare_expr: PASSED")
