Note: ===== Convenience Layer =====

Note: Create oscillator with default sample rate
proc createOsc(Double: frequency)
    (createOscillatorState frequency DEFAULT_SAMPLE_RATE)
end proc

Note: Create sine tone with specified duration, frequency, and amplitude
proc createSineTone(Double: duration, Double: frequency, Double: amplitude)
    Buffer b = (createBufferStereo duration)
    (generateSine b (createOsc frequency) amplitude)
    b
end proc

Note: createSineTone(Double, Hertz, Double) — explicit frequency-type ergonomics
Note: Stereo body matches the bare-Double form above. The C# Hertz overload registered in
Note: BuiltInFunctions.cs serves as the underlying-primitive surface; this Flow proc shadows
Note: it for user-facing calls so the resulting buffer matches the bare-Double form's stereo
Note: layout (the C# CreateSineTone produces a mono buffer; the Flow proc above produces
Note: stereo via createBufferStereo). Per-sample identity vs the bare-Double form holds by
Note: construction since both delegate to the same generateSine + createOsc pipeline.
proc createSineTone(Double: duration, Hertz: freqHz, Double: amplitude)
    Buffer b = (createBufferStereo duration)
    (generateSine b (createOsc freqHz) amplitude)
    b
end proc

Note: Create sawtooth tone
proc createSawTone(Double: duration, Double: frequency, Double: amplitude)
    Buffer b = (createBufferStereo duration)
    (generateSaw b (createOsc frequency) amplitude)
    b
end proc

Note: createSawTone(Double, Hertz, Double) — explicit frequency-type ergonomics
Note: Hertz auto-coerces to Double on the createOsc call via HertzType.IsCompatibleWith(Double) + Value.ConvertTo Double-arm.
proc createSawTone(Double: duration, Hertz: freqHz, Double: amplitude)
    Buffer b = (createBufferStereo duration)
    (generateSaw b (createOsc freqHz) amplitude)
    b
end proc

Note: Create square tone
proc createSquareTone(Double: duration, Double: frequency, Double: amplitude)
    Buffer b = (createBufferStereo duration)
    (generateSquare b (createOsc frequency) amplitude)
    b
end proc

Note: createSquareTone(Double, Hertz, Double) — explicit frequency-type ergonomics
proc createSquareTone(Double: duration, Hertz: freqHz, Double: amplitude)
    Buffer b = (createBufferStereo duration)
    (generateSquare b (createOsc freqHz) amplitude)
    b
end proc

Note: Create triangle tone
proc createTriangleTone(Double: duration, Double: frequency, Double: amplitude)
    Buffer b = (createBufferStereo duration)
    (generateTriangle b (createOsc frequency) amplitude)
    b
end proc

Note: createTriangleTone(Double, Hertz, Double) — explicit frequency-type ergonomics
proc createTriangleTone(Double: duration, Hertz: freqHz, Double: amplitude)
    Buffer b = (createBufferStereo duration)
    (generateTriangle b (createOsc freqHz) amplitude)
    b
end proc

Note: Create AR envelope with default sample rate
proc ar(Double: attackSec, Double: releaseSec)
    (createAR attackSec releaseSec DEFAULT_SAMPLE_RATE)
end proc

Note: Create ADSR envelope with default sample rate
proc adsr(Double: attack, Double: decay, Double: sustain, Double: release)
    (createADSR attack decay sustain release DEFAULT_SAMPLE_RATE)
end proc

