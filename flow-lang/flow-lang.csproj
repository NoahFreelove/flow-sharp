<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>FlowLang</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Phase 47 D-47-01: compile-target flavor flag. Default Desktop;
             override via `dotnet build -p:FlowTarget=Web` to produce a
             browser-WASM-compatible library. Single source of truth — no
             separate flow-lang.Web.csproj. -->
        <FlowTarget>Desktop</FlowTarget>
        <!-- Phase 48 D-48-06: required by [JSImport]/[JSExport] source generator
             (SYSLIB1074). The attribute itself is a no-op on Desktop runtimes —
             constant-folded out by the JIT — but the source generator emits the
             marshalling shim regardless of target, so AllowUnsafeBlocks must be
             enabled in both Desktop and Web builds. The shim never executes on
             Desktop (every callsite is gated by OperatingSystem.IsBrowser()). -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Phase 47 D-47-02: FLOW_WEB preprocessor symbol activates Web-target code paths.
         Asymmetric — no FLOW_DESKTOP constant; absence of FLOW_WEB implies Desktop.
         Matches .NET ecosystem convention (NETSTANDARD2_0 etc.). -->
    <PropertyGroup Condition="'$(FlowTarget)' == 'Web'">
        <DefineConstants>$(DefineConstants);FLOW_WEB</DefineConstants>
        <!-- Phase 48 D-48-01: Mono-WASM jiterpreter target. browser-wasm RID activates
             the WASM publish pipeline; jiterpreter is what Blazor uses today and matches
             Microsoft's recommended path for reflection-friendly .NET in browser. -->
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <WasmEnableJiterpreter>true</WasmEnableJiterpreter>
        <!-- Phase 48 D-48-03: invariant globalization saves ~10 MB ICU bundle.
             HybridGlobalization explicitly off (pin — defaults could change across SDK versions). -->
        <InvariantGlobalization>true</InvariantGlobalization>
        <HybridGlobalization>false</HybridGlobalization>
        <!-- Phase 48 D-48-02: aggressive trim mode. Pairs with TrimmerRootDescriptor below
             which preserves FlowType subclasses + interop boundary types (Value, AudioBuffer,
             WebAudioBackend). InternalFunctionRegistry is NOT reflection-heavy per
             48-PATTERNS.md Discrepancy 3 (audit 2026-05-25). -->
        <TrimMode>full</TrimMode>
        <!-- Phase 48 D-48-04: symbol map gated Debug-only. Release strips it for size +
             minor security (don't leak source structure to browser). -->
        <WasmEmitSymbolMap Condition="'$(Configuration)' == 'Debug'">true</WasmEmitSymbolMap>
        <!-- Phase 48 fix(48-06): force the Mono-WASM runtime pack's app-bundle /
             boot-manifest target ON for this LIBRARY project.

             Root cause (confirmed empirically — see .planning/debug/wasm-boot-no-app-bundle.md):
             flow-lang uses plain Microsoft.NET.Sdk (NOT Microsoft.NET.Sdk.WebAssembly),
             so in WasmApp.Common.targets the gate
               _IsLibraryMode = (OutputType == 'Library' AND UsingMicrosoftNETSdkWebAssembly == 'true')
             evaluates empty (UsingMicrosoftNETSdkWebAssembly is unset under the plain SDK),
             which leaves IsBrowserWasmProject + WasmGenerateAppBundle defaulting to FALSE.
             The _WasmGenerateAppBundle target therefore never runs and no
             dotnet.boot.js / _framework/ / AppBundle/ is produced — dotnet.create()
             404s on its boot manifest in the browser.

             Forcing all three properties below fires the runtime-pack app-bundle
             target WITHOUT swapping SDKs (the Microsoft.NET.Sdk.WebAssembly SDK
             ships only with the Blazor stack, not the wasm-tools workload — see
             debug-file "Eliminated" log) and WITHOUT a second project (single-
             source-of-truth Pattern A). Output: AppBundle/_framework/dotnet.boot.js
             (mainAssemblyName: flow-lang.dll) + dotnet.js + dotnet.native.wasm +
             Webcil .wasm assemblies; flow-runtime.js copied to AppBundle/ root via
             WasmMainJSPath + a package.json {"type":"module"}.

             NOTE: app-bundle mode emits assemblies as Webcil (.wasm), NOT .dll —
             the Phase48 test fixtures that enumerate the publish tree were updated
             for the AppBundle/_framework/ + .wasm-assembly layout accordingly. -->
        <WasmGenerateAppBundle>true</WasmGenerateAppBundle>
        <IsBrowserWasmProject>true</IsBrowserWasmProject>
        <WasmMainJSPath>wasm/flow-runtime.js</WasmMainJSPath>
        <!-- index.html is the dev-smoke harness. WasmMainHTMLPath is the runtime
             pack's supported hook for dropping the entry HTML at AppBundle/ root
             (it is auto-added to WasmExtraFilesToDeploy by _WasmGenerateAppBundle).
             It lands beside the WasmMainJSPath-copied flow-runtime.js so the
             harness can import './flow-runtime.js' from the same directory.
             Bundle consumers (Phase 49 SvelteKit) ignore it. -->
        <WasmMainHTMLPath>wasm/index.html</WasmMainHTMLPath>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
      <PackageReference Include="Pidgin" Version="3.5.1" />
    </ItemGroup>

    <!-- Phase 47 D-47-03: Rug.Osc only referenced when @osc surface compiles in.
         Web target strips OscFunctions.cs + OscHandleData.cs below, so Rug.Osc is
         unused and would otherwise pull dead-reference into the Web build. -->
    <ItemGroup Condition="'$(FlowTarget)' != 'Web'">
      <PackageReference Include="Rug.Osc" Version="1.2.5" />
    </ItemGroup>

    <!-- Phase 47 D-47-03: file-level exclusion when FlowTarget=Web. Strip list per
         47-PATTERNS.md §Discrepancies — actual file paths verified against current
         codebase. LiveBlockStatement.cs / LiveBlockRegistry.cs / LambdaCaptureAuditor.cs
         are NOT stripped because Interpreter.cs:133 / ExecutionContext.cs:292 /
         Parser.cs:221 consume them — Plan 47-03 substitutes a parse-time throw. -->
    <ItemGroup Condition="'$(FlowTarget)' == 'Web'">
      <Compile Remove="Audio\PulseAudioSimpleBackend.cs" />
      <Compile Remove="Audio\PulseAudioCaptureBackend.cs" />
      <Compile Remove="Audio\CoreAudioBackend.cs" />
      <Compile Remove="StandardLibrary\Audio\Sfz\**\*.cs" />
      <Compile Remove="StandardLibrary\Network\OscFunctions.cs" />
      <Compile Remove="StandardLibrary\Network\OscHandleData.cs" />
      <Compile Remove="StandardLibrary\Audio\InputFunctions.cs" />
      <!-- Phase 47 D-47-11: belt-and-suspenders Samples strip. PATTERNS.md §Discrepancy 3
           flagged Samples/** has no <None Update> entry today; SDK implicit-include
           behavior may still copy them. Explicit Remove guarantees Web publish omits
           the 3.05 MB U-Iowa MIS bundle (~20% of WASM budget per Phase 48 D-48-03).
           SampledInstrumentRenderer charitably falls back to synthesis per
           SampleCache.cs:265 null-fallback (existing pattern). -->
      <Content Remove="Samples\**" />
      <None Remove="Samples\**" />
      <!-- Skip copying stripped stdlib .flow files to Web publish output. The
           existing <None Update> entries (osc.flow / sfz.flow) define
           CopyToOutputDirectory — without these Remove entries the Web
           publish would still ship the files even though SfzBuiltins.cs and
           OscFunctions.cs are absent. Modulo Plan 47-03's ModuleLoader gate. -->
      <None Remove="sfz.flow" />
      <None Remove="osc.flow" />
      <!-- Phase 48 D-48-02: trimmer-root descriptor preserving FlowType subclasses,
           music-type singletons, and the interop boundary types Phase 48 marshals across
           [JSImport]/[JSExport] (Value, AudioBuffer, WebAudioBackend). Per
           48-PATTERNS.md §Discrepancy 3, InternalFunctionRegistry is NOT enumerated —
           it's not reflection-heavy and reachability analysis already covers it
           through FlowEngine's static call chain. -->
      <TrimmerRootDescriptor Include="wasm\trim-roots.xml" />
      <!-- Phase 48 fix(48-06): the dev-smoke harness (index.html) and the runtime
           ES module (flow-runtime.js) are deployed into the generated AppBundle/
           root via WasmMainHTMLPath / WasmMainJSPath above — the runtime pack's
           _WasmGenerateAppBundle target owns that copy. We therefore SKIP the old
           flat-tree CopyToPublishDirectory hooks (they would land stale duplicates
           divorced from the bootable AppBundle). -->
      <!-- trim-roots.xml is referenced by <TrimmerRootDescriptor> above at
           BUILD time only — explicitly skip copying it to the publish output
           so it doesn't bloat the AppBundle. -->
      <None Update="wasm\trim-roots.xml">
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      </None>
      <None Update="wasm\flow-runtime.js">
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      </None>
      <None Update="wasm\index.html">
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      </None>

      <!-- Phase 48 fix(48-06): embed the surviving stdlib .flow modules into
           flow-lang.wasm so `use "@std"` (and the transitive @collections/@bars,
           plus the opt-in @audio/@patterns/@generative/@improv/@notation/@notation-io)
           resolve in the BROWSER. The Emscripten VFS has no host filesystem, so
           the CopyToPublishDirectory copies that Desktop relies on are absent in
           WASM. ModuleLoader.TryReadEmbeddedModule resolves these by the stable
           LogicalName "FlowLang.Stdlib.<relative>". Web-only: Desktop reads the
           same files from disk and never touches the embedded copy. sfz.flow /
           osc.flow are NOT embedded (stripped on Web per Phase 47 D-47-03; the
           ModuleLoader Web strip-gate rejects @sfz/@osc before any read). See debug
           session wasm-boot-no-app-bundle (cycle 4). -->
      <EmbeddedResource Include="std.flow">
        <LogicalName>FlowLang.Stdlib.std.flow</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="collections.flow">
        <LogicalName>FlowLang.Stdlib.collections.flow</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="bars.flow">
        <LogicalName>FlowLang.Stdlib.bars.flow</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="audio.flow">
        <LogicalName>FlowLang.Stdlib.audio.flow</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="composition.flow">
        <LogicalName>FlowLang.Stdlib.composition.flow</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="generative.flow">
        <LogicalName>FlowLang.Stdlib.generative.flow</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="improv.flow">
        <LogicalName>FlowLang.Stdlib.improv.flow</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="notation.flow">
        <LogicalName>FlowLang.Stdlib.notation.flow</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="notation-io.flow">
        <LogicalName>FlowLang.Stdlib.notation-io.flow</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="patterns.flow">
        <LogicalName>FlowLang.Stdlib.patterns.flow</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="improv\styles\jazz.flow">
        <LogicalName>FlowLang.Stdlib.improv/styles/jazz.flow</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="improv\styles\blues.flow">
        <LogicalName>FlowLang.Stdlib.improv/styles/blues.flow</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="improv\styles\classical.flow">
        <LogicalName>FlowLang.Stdlib.improv/styles/classical.flow</LogicalName>
      </EmbeddedResource>
    </ItemGroup>

    <!-- Phase 35 HK-03: expose internals to the xUnit project so
         MutateRhythmEnumValuesTests can call the internal MutateRhythm helper
         directly (04-VERIFICATION.md gap closure regression). -->
    <ItemGroup>
      <InternalsVisibleTo Include="flow-lang.Tests" />
    </ItemGroup>

    <ItemGroup>
      <None Update="std.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="collections.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="audio.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="bars.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="notation.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="notation-io.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <!-- Phase 38 Plan 38-06 — OSC opt-in module. Loaded via `use "@osc"`;
           registers the __enableOscModule marker and 5 forward decls
           (oscSend / oscListen / oscStop / oscBundle / oscSendBundle). -->
      <None Update="osc.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="composition.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="sfz.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="patterns.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="generative.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="improv.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <!-- Phase 36 Plan 36-11: ship the 3 baseline rule packs + README at
           runtime alongside the improv.flow stdlib module. StyleRegistry
           reads them from {AppContext.BaseDirectory}/improv/styles/ at
           FlowEngine init. -->
      <None Update="improv\styles\jazz.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="improv\styles\blues.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="improv\styles\classical.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="improv\styles\README.md">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="test.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="bin\Debug\net9.0\" />
    </ItemGroup>

</Project>
