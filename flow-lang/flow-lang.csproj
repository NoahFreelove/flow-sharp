<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>FlowLang</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Phase 47 D-47-01: compile-target flavor flag. Default Desktop;
             override via `dotnet build -p:FlowTarget=Web` to produce a
             browser-WASM-compatible library. Single source of truth — no
             separate flow-lang.Web.csproj. -->
        <FlowTarget>Desktop</FlowTarget>
    </PropertyGroup>

    <!-- Phase 47 D-47-02: FLOW_WEB preprocessor symbol activates Web-target code paths.
         Asymmetric — no FLOW_DESKTOP constant; absence of FLOW_WEB implies Desktop.
         Matches .NET ecosystem convention (NETSTANDARD2_0 etc.). -->
    <PropertyGroup Condition="'$(FlowTarget)' == 'Web'">
        <DefineConstants>$(DefineConstants);FLOW_WEB</DefineConstants>
        <!-- Phase 48 D-48-01: Mono-WASM jiterpreter target. browser-wasm RID activates
             the WASM publish pipeline; jiterpreter is what Blazor uses today and matches
             Microsoft's recommended path for reflection-friendly .NET in browser. -->
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <WasmEnableJiterpreter>true</WasmEnableJiterpreter>
        <!-- Phase 48 D-48-03: invariant globalization saves ~10 MB ICU bundle.
             HybridGlobalization explicitly off (pin — defaults could change across SDK versions). -->
        <InvariantGlobalization>true</InvariantGlobalization>
        <HybridGlobalization>false</HybridGlobalization>
        <!-- Phase 48 D-48-02: aggressive trim mode. Pairs with TrimmerRootDescriptor below
             which preserves FlowType subclasses + interop boundary types (Value, AudioBuffer,
             WebAudioBackend). InternalFunctionRegistry is NOT reflection-heavy per
             48-PATTERNS.md Discrepancy 3 (audit 2026-05-25). -->
        <TrimMode>full</TrimMode>
        <!-- Phase 48 D-48-04: symbol map gated Debug-only. Release strips it for size +
             minor security (don't leak source structure to browser). -->
        <WasmEmitSymbolMap Condition="'$(Configuration)' == 'Debug'">true</WasmEmitSymbolMap>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
      <PackageReference Include="Pidgin" Version="3.5.1" />
    </ItemGroup>

    <!-- Phase 47 D-47-03: Rug.Osc only referenced when @osc surface compiles in.
         Web target strips OscFunctions.cs + OscHandleData.cs below, so Rug.Osc is
         unused and would otherwise pull dead-reference into the Web build. -->
    <ItemGroup Condition="'$(FlowTarget)' != 'Web'">
      <PackageReference Include="Rug.Osc" Version="1.2.5" />
    </ItemGroup>

    <!-- Phase 47 D-47-03: file-level exclusion when FlowTarget=Web. Strip list per
         47-PATTERNS.md §Discrepancies — actual file paths verified against current
         codebase. LiveBlockStatement.cs / LiveBlockRegistry.cs / LambdaCaptureAuditor.cs
         are NOT stripped because Interpreter.cs:133 / ExecutionContext.cs:292 /
         Parser.cs:221 consume them — Plan 47-03 substitutes a parse-time throw. -->
    <ItemGroup Condition="'$(FlowTarget)' == 'Web'">
      <Compile Remove="Audio\PulseAudioSimpleBackend.cs" />
      <Compile Remove="Audio\PulseAudioCaptureBackend.cs" />
      <Compile Remove="Audio\CoreAudioBackend.cs" />
      <Compile Remove="StandardLibrary\Audio\Sfz\**\*.cs" />
      <Compile Remove="StandardLibrary\Network\OscFunctions.cs" />
      <Compile Remove="StandardLibrary\Network\OscHandleData.cs" />
      <Compile Remove="StandardLibrary\Audio\InputFunctions.cs" />
      <!-- Phase 47 D-47-11: belt-and-suspenders Samples strip. PATTERNS.md §Discrepancy 3
           flagged Samples/** has no <None Update> entry today; SDK implicit-include
           behavior may still copy them. Explicit Remove guarantees Web publish omits
           the 3.05 MB U-Iowa MIS bundle (~20% of WASM budget per Phase 48 D-48-03).
           SampledInstrumentRenderer charitably falls back to synthesis per
           SampleCache.cs:265 null-fallback (existing pattern). -->
      <Content Remove="Samples\**" />
      <None Remove="Samples\**" />
      <!-- Skip copying stripped stdlib .flow files to Web publish output. The
           existing <None Update> entries (osc.flow / sfz.flow) define
           CopyToOutputDirectory — without these Remove entries the Web
           publish would still ship the files even though SfzBuiltins.cs and
           OscFunctions.cs are absent. Modulo Plan 47-03's ModuleLoader gate. -->
      <None Remove="sfz.flow" />
      <None Remove="osc.flow" />
      <!-- Phase 48 D-48-02: trimmer-root descriptor preserving FlowType subclasses,
           music-type singletons, and the interop boundary types Phase 48 marshals across
           [JSImport]/[JSExport] (Value, AudioBuffer, WebAudioBackend). Per
           48-PATTERNS.md §Discrepancy 3, InternalFunctionRegistry is NOT enumerated —
           it's not reflection-heavy and reachability analysis already covers it
           through FlowEngine's static call chain. -->
      <TrimmerRootDescriptor Include="wasm\trim-roots.xml" />
    </ItemGroup>

    <!-- Phase 35 HK-03: expose internals to the xUnit project so
         MutateRhythmEnumValuesTests can call the internal MutateRhythm helper
         directly (04-VERIFICATION.md gap closure regression). -->
    <ItemGroup>
      <InternalsVisibleTo Include="flow-lang.Tests" />
    </ItemGroup>

    <ItemGroup>
      <None Update="std.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="collections.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="audio.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="bars.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="notation.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="notation-io.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <!-- Phase 38 Plan 38-06 — OSC opt-in module. Loaded via `use "@osc"`;
           registers the __enableOscModule marker and 5 forward decls
           (oscSend / oscListen / oscStop / oscBundle / oscSendBundle). -->
      <None Update="osc.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="composition.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="sfz.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="patterns.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="generative.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="improv.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <!-- Phase 36 Plan 36-11: ship the 3 baseline rule packs + README at
           runtime alongside the improv.flow stdlib module. StyleRegistry
           reads them from {AppContext.BaseDirectory}/improv/styles/ at
           FlowEngine init. -->
      <None Update="improv\styles\jazz.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="improv\styles\blues.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="improv\styles\classical.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="improv\styles\README.md">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="test.flow">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="bin\Debug\net9.0\" />
    </ItemGroup>

</Project>
