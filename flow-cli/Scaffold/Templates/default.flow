// {{PIECE_NAME}}.flow — generated by flow new
//
// Run with:    flow run {{PIECE_NAME}}.flow
// Render to:   flow render {{PIECE_NAME}}.flow -o {{PIECE_NAME}}.wav
// Play live:   flow play {{PIECE_NAME}}.flow

use "@std"
use "@audio"
use "@notation"

tempo 120 {
    timesig 4/4 {
        key Cmajor {

            section main {
                Sequence melody = | C4q D4q E4q F4q | G4q F4q E4q D4q | C4w |
            }

            Song song = [main]
            Buffer output = (renderSong song "piano")
            (writeWav "{{PIECE_NAME}}.wav" output)
        }
    }
}
