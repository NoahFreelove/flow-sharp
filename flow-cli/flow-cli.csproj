<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FlowCli</RootNamespace>
    <AssemblyName>flow</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.5.0</Version>
    <InformationalVersion>1.5.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\flow-lang\flow-lang.csproj" />
    <ProjectReference Include="..\flow-interpreter\flow-interpreter.csproj" />
    <ProjectReference Include="..\flow-midi\flow-midi.csproj" />
    <ProjectReference Include="..\flow-lsp\flow-lsp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.7" />
    <!-- Tomlyn 2.3.2 moved to flow-lang.csproj (sweep-0614 config fix) so the
         bare interpreter (flow-interpreter) can also load ~/.config/flow/config.toml
         via the now-shared FlowLang.Runtime.FlowConfigLoader. flow-cli still uses
         it transitively through the flow-lang ProjectReference. -->
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scaffold\Templates\default.flow" />
  </ItemGroup>

</Project>
