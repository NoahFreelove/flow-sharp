<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 30 REQ-2: self-contained Linux x64 single-file publish profile for flow-cli.

  Flag set locked in .planning/phases/30-flow-cli-formal-install/30-RESEARCH.md
  (dotnet publish Profile section). Mirror of the flag set in scripts/publish.sh.

  Usage:
    dotnet publish flow-cli -p:PublishProfile=linux-x64

  DO NOT add PublishReadyToRun=true — known regression with
  EnableCompressionInSingleFile per dotnet/runtime#101866.

  DO NOT change PublishTrimmed — reflection in flow-lang's OverloadResolver,
  InternalFunctionRegistry, and ModuleLoader requires trim=false (RESEARCH
  Assumption A2).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>publish/flow-linux-x64/</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
