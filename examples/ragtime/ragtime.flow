// =====================================================================
// Stride & Stomp -- v1.4 showcase #2 (ragtime; companion to symphony)
// =====================================================================
// Solo piano via the Phase 33 SFZ sampler against VSCO Community CE's
// UprightPiano.sfz. Classic ragtime: stride left-hand (alternating bass
// note on beats 1 & 3, mid-range chord on 2 & 4) under a syncopated
// right-hand melody. F major, tempo 100, 4/4, ABA single-movement,
// ~58s rendered duration. The piece's mood is intentionally OPPOSITE
// the symphony's pensive D minor -- this shows Flow's genre-agnostic
// reach inside one v1.4 release.
//
// Render with:
//   dotnet run --project flow-cli -- render examples/ragtime/ragtime.flow -o ignored.wav
// (the -o flag is ignored at Phase 30 -- the writeWav target below is
// the real output path, relative to your current working directory).
//
// Setup: same as examples/symphony/symphony.flow -- requires VSCO-CE
// 1.1.0 installed and sfz_root set in ~/.config/flow/config.toml.
// See examples/ragtime/README.md.

use "@std"
use "@audio"
use "@sfz"
use "@composition"

// ---------------------------------------------------------------------
// Solo piano binding (single SFZ patch -- the simplest possible
// renderSong "sampler:NAME" pipeline).
// ---------------------------------------------------------------------
Sfz piano = (loadSfz #piano)

// ---------------------------------------------------------------------
// Musical context -- voicePool 32 (Phase 28 SPEC-7 locked default)
// nested under tempo / timesig / key for the whole piece.
// ---------------------------------------------------------------------
voicePool 32 {
    tempo 100 {
        timesig 4/4 {
            key Fmajor {

                // =====================================================
                // Section A (themeA) -- 4 bars of classic ragtime stride.
                // LH plays bass note + mid-range chord + bass note +
                // chord (one note per beat); RH plays a syncopated
                // melody with accent (`>`) on off-beat downbeats and
                // staccato (`stacc`) tightening the bass notes. The
                // swing feel emerges from the articulation contrast --
                // sharp staccato bass under a more sustained RH line.
                //
                // Note: humanizeGaussian is intentionally NOT applied
                // here. The current interpreter silently produces an
                // empty render when humanize wraps a voice-block-bearing
                // sequence (a v1.5 follow-up). The piece's swing comes
                // from the articulation contrast alone, which works
                // out fine -- ragtime is typically played close to
                // straight anyway.
                // =====================================================
                section themeA {
                    Sequence ragA = |
                        {voice F2q stacc [A2 C3 F3]q F2q stacc [A2 C3 F3]q}
                        {voice F4e> C5e F5q. A4q G4q}
                        |
                        {voice F2q stacc [A2 C3 F3]q F2q stacc [A2 C3 F3]q}
                        {voice A4e C5e F5e D5e C5q A4q}
                        |
                        {voice F2q stacc [A2 C3 F3]q F2q stacc [A2 C3 F3]q}
                        {voice {3:2 F4 G4 A4}q C5q A4q F4q}
                        |
                        {voice F2q stacc [A2 C3 F3]q C3q stacc [E3 G3 Bb3]q}
                        {voice E4q F4q C4q A3q}
                        |
                }

                // =====================================================
                // Section B (themeB) -- modulation cycle through Bb
                // (subdominant), Gm (relative minor), back to F. RH
                // melody opens with a `marc` (marcato) attack to mark
                // the section shift, then a `leg` (legato) phrase
                // smooths into the middle. LH stride continues with
                // the harmony.
                // =====================================================
                section themeB {
                    Sequence ragB = |
                        {voice Bb2q stacc [D3 F3 Bb3]q Bb2q stacc [D3 F3 Bb3]q}
                        {voice Bb4q marc A4e G4e Bb4q F4q}
                        |
                        {voice G2q stacc [Bb2 D3 G3]q G2q stacc [Bb2 D3 G3]q}
                        {voice D5q. C5e Bb4q A4q leg}
                        |
                        {voice C3q stacc [E3 G3 C4]q C3q stacc [E3 G3 C4]q}
                        {voice G4e A4e Bb4e G4e F4q E4q}
                        |
                        {voice F2q stacc [A2 C3 F3]q C3q stacc [E3 G3 Bb3]q}
                        {voice F4q ten A4q ten C5q ten A4q ten}
                        |
                }

                // =====================================================
                // Section A' (themeAPrime) -- return to A with the
                // final bar resolving on a big tenuto-then-marcato
                // cadence. RH adds a legato passing line over the
                // 3rd bar. This is the bright upbeat finish that
                // contrasts the symphony's pensive D-minor close.
                // =====================================================
                section themeAPrime {
                    Sequence ragAPrime = |
                        {voice F2q stacc [A2 C3 F3]q F2q stacc [A2 C3 F3]q}
                        {voice F4e> C5e F5q. A4q G4q}
                        |
                        {voice F2q stacc [A2 C3 F3]q F2q stacc [A2 C3 F3]q}
                        {voice A4e C5e F5e D5e C5q A4q}
                        |
                        {voice F2q stacc [A2 C3 F3]q F2q stacc [A2 C3 F3]q}
                        {voice F4q A4q leg C5q F5q leg}
                        |
                        {voice F2q stacc [A2 C3 F3]q F2q stacc [A2 C3 F3]q}
                        {voice F4h marc A4h marc}
                        |
                }

                // =====================================================
                // Song arrangement -- ABA single-movement (D-102 echo).
                // Each section repeats once (8 bars total per section)
                // for a ~58s rendered duration at tempo 100.
                // =====================================================
                Song piece = [themeA*2 themeB*2 themeAPrime*2]

                // =====================================================
                // Single-instrument render -- solo piano via the
                // Phase 33 sampler:NAME dispatch.
                // =====================================================
                Buffer raw = (renderSong piece "sampler:piano")

                // =====================================================
                // Mix: solo piano needs MUCH less processing than the
                // symphony's 5-instrument mix. A touch of room reverb
                // (15% wet / 1.5s tail -- "small stage" not "concert
                // hall") plus a gentler compressor (3:1 above -10dB,
                // 50ms attack / 100ms release) preserves the percussive
                // ragtime feel without crushing the dynamics.
                // =====================================================
                Buffer wet      = raw -> (reverb 0.15 1.5s)
                Buffer mastered = wet -> (compress -10dB 3 50ms 100ms)

                // =====================================================
                // Write outputs to examples/output/ (gitignored by
                // .gitignore established in Phase 27).
                // =====================================================
                (writeWav "examples/output/ragtime.wav" mastered)
                (writeMidi "examples/output/ragtime.mid" piece)
            }
        }
    }
}
