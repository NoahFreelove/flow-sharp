// =====================================================================
// In Five Voices -- v1.4 symphony showcase (Phase 34, ABA ~60s)
// =====================================================================
// 5 VSCO Community CE 1.1.0 SFZ instruments routed through the Phase 33
// sampler:NAME dispatch. ABA single-movement minimalist piece in D minor
// at tempo 100. Render with:
//   flow render examples/symphony/symphony.flow -o ignored.wav
// (the -o flag is ignored at Phase 30 -- the writeWav target below is the
// real output path, relative to your current working directory).
//
// Setup: install VSCO-CE 1.1.0 at the path bound to sfz_root in
// ~/.config/flow/config.toml. See examples/symphony/README.md for details.

use "@std"
use "@audio"
use "@sfz"
use "@composition"

// ---------------------------------------------------------------------
// 1. Patch bindings (5 VSCO-CE instruments via the 19-entry GM dict)
// ---------------------------------------------------------------------
Sfz violin  = (loadSfz #violin)
Sfz cello   = (loadSfz #cello)
Sfz flute   = (loadSfz #flute)
Sfz horn    = (loadSfz #horn)
Sfz timpani = (loadSfz #timpani)

// ---------------------------------------------------------------------
// 2. Musical context -- voicePool 32 (Phase 28 SPEC-7 locked default)
//    nested under tempo / timesig / key for the whole movement.
// ---------------------------------------------------------------------
voicePool 32 {
    tempo 100 {
        timesig 4/4 {
            key Dminor {

                // =====================================================
                // Section A (themeA) -- flute carries the theme,
                // cello holds sustained bass (humanized, seed=42),
                // horn enters under the second pair of bars as a pad.
                // Phase 28 articulation tokens: > (accent) on flute
                // downbeats, ten (tenuto) on horn pad notes,
                // leg (legato) on cello sustained bass.
                // =====================================================
                section themeA {
                    Sequence fluteMelody = | D5q> E5q F5q A5h | G5q. F5e E5q D5h | F5q> E5q D5q A4h | E5q. D5e C5q D5h |
                    Sequence celloBass   = (humanizeGaussian | D3w leg | A2w leg | F3w leg | G2w leg | 0.05 42)
                    Sequence hornPad     = | _ | _ | A3w ten | F3w ten |
                }

                // =====================================================
                // Transition A -> B -- single timpani marcato hit
                // marking the section boundary (D-203).
                // =====================================================
                section transitionAB {
                    Sequence timpHit = | _ _ _ D2q marc |
                }

                // =====================================================
                // Section B (themeB) -- contrasting middle. Horn takes
                // the lead with a held melodic line, flute answers with
                // a triplet flourish (the D-303 tuplet bracket lives
                // here), cello slides into legato whole notes.
                // =====================================================
                section themeB {
                    Sequence hornLead   = | F4h F4 ten G4q | A4h. G4q | F4w | E4w |
                    Sequence fluteOrn   = | _ | {3:2 D5 E5 F5}q D5e stacc _ _ _ | _ | _ |
                    Sequence celloLeg   = | F3w leg | E3w leg | D3w leg | A2w leg |
                }

                // =====================================================
                // Transition B -> A' -- second timpani marcato hit.
                // =====================================================
                section transitionBAPrime {
                    Sequence timpHit = | _ _ _ A2q marc |
                }

                // =====================================================
                // Section A' (themeAPrime) -- violin enters octave-up
                // via the (transpose ... 12) transform carrying the
                // A-theme; cello uses the {voice ...}{voice ...} block
                // for D-301 polyphony (held bass + inner harmony line);
                // horn fills out a tenuto pad; flute holds a long
                // harmony above. This is the fullest moment in the arc.
                // =====================================================
                section themeAPrime {
                    Sequence violinTheme  = (transpose | D5q> E5q F5q A5h | G5q. F5e E5q D5h | F5q> E5q D5q A4h | E5q. D5e C5q D5h | 12)
                    Sequence celloVoiced  = | {voice D3w} {voice A3h F3h} | {voice A2w} {voice F3h E3h} | {voice F3w} {voice A3h G3h} | {voice G2w} {voice D3h F3h} |
                    Sequence hornPadFull  = | A3w ten | G3w ten | F3w ten | D3w ten |
                    Sequence fluteHarmony = | A5w | G5w | F5w | D5w |
                }

                // =====================================================
                // Song arrangement -- ABA single-movement (D-102)
                // =====================================================
                Song piece = [themeA*2 transitionAB themeB*2 transitionBAPrime themeAPrime*2]

                // =====================================================
                // Per-instrument render via the Phase 33 sampler:NAME
                // dispatch. Each call routes through SfzRenderer using
                // the bound patch variable name (D-13).
                // =====================================================
                Buffer rawViolin  = (renderSong piece "sampler:violin")
                Buffer rawCello   = (renderSong piece "sampler:cello")
                Buffer rawFlute   = (renderSong piece "sampler:flute")
                Buffer rawHorn    = (renderSong piece "sampler:horn")
                Buffer rawTimpani = (renderSong piece "sampler:timpani")

                // =====================================================
                // D-401: per-instrument volume balance (linear, NOT
                // gain -- linear is the intuitive surface for "85% of
                // full"). UAT iteration #2 (composer feedback: "melody
                // clobbered, flutes should shine more than the super
                // loud bass"): flute boosted to lead at 1.0; cello +
                // horn dropped substantially so the flute melody sits
                // clear of the sustained bass bed.
                // =====================================================
                Buffer balViolin  = (volume rawViolin  0.85)
                Buffer balCello   = (volume rawCello   0.45)
                Buffer balFlute   = (volume rawFlute   1.0)
                Buffer balHorn    = (volume rawHorn    0.40)
                Buffer balTimpani = (volume rawTimpani 0.35)

                // =====================================================
                // Mix via the (mix Buffer Buffer) builtin (verified in
                // flow-lang/StandardLibrary/BuiltInFunctions.cs:597 --
                // takes 2 Buffers, returns 1 Buffer). Chain 4 mixes to
                // sum 5 per-instrument buffers down to one.
                // =====================================================
                Buffer mix1   = (mix balViolin balCello)
                Buffer mix2   = (mix mix1 balFlute)
                Buffer mix3   = (mix mix2 balHorn)
                Buffer summed = (mix mix3 balTimpani)

                // =====================================================
                // D-402: master reverb on the summed mix. UAT iteration
                // #2 (composer feedback: melody clobbered): wet level
                // dropped from 0.30 -> 0.20 so the 2.5s tail stops
                // smearing each whole-note pad into the next bar's
                // melodic onset. Hall character preserved (2.5s decay
                // tail unchanged); just less of it in the mix.
                // D-403: soft 4:1 compressor above -12dB threshold
                //   (Phase 26.2 Decibel + Millisecond literals).
                // =====================================================
                Buffer wet      = summed -> (reverb 0.2 2.5s)
                Buffer mastered = wet -> (compress -12dB 4 100ms 200ms)

                // =====================================================
                // D-504: write to examples/output/symphony.{wav,mid}
                // (relative to cwd; .gitignore already covers it).
                // =====================================================
                (writeWav "examples/output/symphony.wav" mastered)
                (writeMidi "examples/output/symphony.mid" piece)
            }
        }
    }
}
