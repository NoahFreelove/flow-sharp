{
  "Version": 1,
  "Manifest": "{\"ApiVersion\":1,\"Id\":\"flow.examples.sampled-drum\",\"Name\":\"Sampled drum\",\"Author\":\"Flow examples\",\"License\":\"Repository terms\",\"Version\":\"1.0.0\",\"SourceSha256\":\"9248cb47373af13c32045e02d454e4ff285ca733385713aeae4a663cc287a3b6\",\"Builder\":\"build\",\"Kind\":\"Instrument\",\"AudioInputs\":0,\"AudioOutputs\":1,\"NoteInput\":true,\"NoteOutput\":false,\"MinimumSampleRate\":8000,\"MaximumSampleRate\":192000,\"MaximumBlockFrames\":4096,\"StateSchema\":\"reset-v1\",\"StatePolicy\":\"Reset\",\"Parameters\":[{\"Id\":\"level\",\"Name\":\"Level\",\"Unit\":\"linear\",\"Minimum\":0,\"Maximum\":1,\"Default\":0.25,\"Scale\":\"Linear\",\"SmoothingMilliseconds\":5,\"RequiresRebuild\":false,\"Labels\":[]},{\"Id\":\"cutoff\",\"Name\":\"Cutoff\",\"Unit\":\"Hz\",\"Minimum\":20,\"Maximum\":12000,\"Default\":500,\"Scale\":\"Linear\",\"SmoothingMilliseconds\":5,\"RequiresRebuild\":false,\"Labels\":[]},{\"Id\":\"release\",\"Name\":\"Release\",\"Unit\":\"ms\",\"Minimum\":0,\"Maximum\":5000,\"Default\":120,\"Scale\":\"Linear\",\"SmoothingMilliseconds\":0,\"RequiresRebuild\":true,\"Labels\":[]}],\"Dependencies\":[{\"Id\":\"kick\",\"Version\":\"1\",\"Sha256\":\"0e0a8cc52184d361351e58e8f753f9f060cbd8cbe5c47cc4feb1b1db418b2c79\"}]}",
  "Source": "use \"@flowDaw\"\n\nNote: Each prepared voice receives pitch Hz, gate and velocity on buses 0, 1 and 2.\nproc build (Dict<String, Double>: context)\n    AudioGraph pitch = (dawInput \"pitch\" 0)\n    AudioGraph gate = (dawInput \"gate\" 1)\n    AudioGraph velocity = (dawInput \"velocity\" 2)\n    AudioGraph envelope = (dawAdsr \"envelope\" gate 5ms 80ms 0.6 120ms)\n    AudioGraph saw = (dawSample \"reader\" pitch gate 0 110.0)\n    AudioGraph cutoff = (dawMix \"cutoff\" (dawValue \"baseCutoff\" 500.0) (dawMultiply \"sweep\" envelope (dawValue \"depth\" 2500.0)))\n    AudioGraph tone = (dawLowPass \"filter\" saw cutoff)\n    AudioGraph shaped = (dawMultiply \"shaped\" tone envelope)\n    AudioGraph output = (dawMultiply \"output\" shaped velocity)\n    DawAudio sample = (dawPluginSample \"kick\")\n    Dict<Int, DawAudio> assets = (dict 0 sample)\n    DawInstrument synth = (dawSampleInstrument (dawGain \"level\" output 0.25) 16 assets)\n    (dawResult \"instrument\" synth)\nend proc\n",
  "OutputLayer": "instrument",
  "Targets": [
    {
      "ParameterId": "level",
      "NodeId": "level",
      "DeviceParameterId": "gain"
    },
    {
      "ParameterId": "cutoff",
      "NodeId": "baseCutoff",
      "DeviceParameterId": "value"
    },
    {
      "ParameterId": "release",
      "NodeId": "envelope",
      "DeviceParameterId": "releaseMs"
    }
  ],
  "Dependencies": [
    {
      "Id": "kick",
      "Version": "1",
      "Base64": ""
    }
  ]
}
