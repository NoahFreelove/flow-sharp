// Maple Leaf Rag — Scott Joplin (1899). Public domain.
// First 8 bars hand-transcribed for Phase 28 polyphony testing.
// Refinement welcome during manual UAT.
//
// Render with: dotnet run --project flow-interpreter examples/tests/maple_leaf_opening.flow
// Output: examples/output/maple_leaf_opening.wav + .mid

use "@std"
use "@audio"
use "@notation"

tempo 76 {
    timesig 2/4 {
        key Abmajor {
            // Stride pattern: alternating bass + mid-chord on each beat.
            // RH: syncopated melodic line.
            Sequence main =
                | {voice Ab1q [Eb3 Ab3 C4]q} {voice Eb5e G5e Ab5e Bb5e} |
                | {voice Ab1q [Eb3 Ab3 C4]q} {voice Db6e Bb5e Ab5e G5e} |
                | {voice Bb1q [F3 Bb3 D4]q} {voice F5e Ab5e Bb5e C6e} |
                | {voice Bb1q [F3 Bb3 D4]q} {voice Eb6e C6e Bb5e Ab5e} |
                | {voice Eb1q [Bb2 Eb3 G3]q} {voice G5e Bb5e Eb6e Db6e} |
                | {voice Eb1q [Bb2 Eb3 G3]q} {voice Bb5e Ab5e G5e F5e} |
                | {voice Ab1q [Eb3 Ab3 C4]q} {voice Eb5q Ab5q} |
                | {voice Ab1q [Eb3 Ab3 C4]q} {voice C5q Eb5q} |

            section maple_leaf { Sequence v = main }
            Song s = [maple_leaf]
            Buffer mix = (renderSong s "piano")
            (writeWav "examples/output/maple_leaf_opening.wav" mix)
            (writeMidi "examples/output/maple_leaf_opening.mid" s)
        }
    }
}
