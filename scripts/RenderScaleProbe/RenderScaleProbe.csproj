<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- -p:LegacyOnly=true builds against revisions that predate Flow.Audio. -->
    <DefineConstants Condition="'$(LegacyOnly)' == 'true'">$(DefineConstants);LEGACY_ONLY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../flow-lang/flow-lang.csproj" />
  </ItemGroup>
</Project>
