// flow-lang.Tests/fixtures/Phase37/velocity_xfade.sfz — Plan 37-03 SAMP-02 fixture
// Two regions whose velocity ranges overlap in [60, 80]. The lower layer
// declares xfout_lovel=60 xfout_hivel=80 (fade-out as velocity rises); the
// upper layer declares xfin_lovel=60 xfin_hivel=80 (fade-in as velocity
// rises). Combined they form an equal-power crossfade across vel [60, 80].

<region>
sample=../sfz-smoke/C4_sine.wav
pitch_keycenter=60
lokey=60 hikey=60 lovel=1 hivel=80
xfout_lovel=60 xfout_hivel=80

<region>
sample=../sfz-smoke/C4_sine.wav
pitch_keycenter=60
lokey=60 hikey=60 lovel=60 hivel=127
xfin_lovel=60 xfin_hivel=80
