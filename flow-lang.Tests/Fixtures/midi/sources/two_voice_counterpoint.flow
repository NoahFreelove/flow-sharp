use "@std"
use "@audio"
use "@notation"

tempo 120 {
    timesig 4/4 {
        key Cmajor {
            section main {
                Sequence cp = | {voice C4q D4q E4q F4q} {voice C5q D5q E5q F5q} |
            }
            Song song = [main]
            (writeMidi "flow-lang.Tests/Fixtures/midi/two_voice_counterpoint.mid" song)
        }
    }
}
