.idea/
tests/
*.flow
*.md
!.planning/**/*.md
!CLAUDE.md
flow-interpreter/flow-interpreter
*.wav
.claude/plugins/*

# VSCode extension build artifacts
vscode-extension/node_modules/
vscode-extension/out/
vscode-extension/server/
*.vsix

# VSCode extension sources must be tracked even though tests/ and *.flow
# are globally ignored above.
!vscode-extension/tests/
!vscode-extension/tests/**
!vscode-extension/tests/**/*.flow
!vscode-extension/README.md

# Pragma companion files for Phase 27 byte-identical determinism gates
# must be tracked despite the global *.flow ignore.
!examples/pragmas/
!examples/pragmas/**
!examples/pragmas/**/*.flow

# Phase 32 Scala tuning tutorial chapter (D-19) — examples/scala/intro.flow
# + README.md must be tracked despite the global *.flow / *.md ignores.
# Mirrors the examples/pragmas/ precedent.
!examples/scala/
!examples/scala/**
!examples/scala/**/*.flow
!examples/scala/**/*.md

# Phase 33 SFZ orchestral sampler tutorial chapter — examples/symphony/sfz_smoke.flow
# + README.md must be tracked despite the global *.flow / *.md ignores.
# Mirrors the examples/scala/ precedent.
!examples/symphony/
!examples/symphony/**
!examples/symphony/**/*.flow
!examples/symphony/**/*.md

# Phase 34 showcase #2 — examples/ragtime/ragtime.flow + README.md must be
# tracked despite the global *.flow / *.md ignores. Mirrors examples/symphony/.
!examples/ragtime/
!examples/ragtime/**
!examples/ragtime/**/*.flow
!examples/ragtime/**/*.md

# Phase 36 Plan 36-12 — composer-facing tutorial chapters for the @patterns
# combinators (examples/generative/tidal_combinators.flow), generative
# primitives + jam (examples/generative/markov_jazz.flow), and
# parameterized sections (examples/sections/parameterized.flow). Mirrors
# the examples/symphony/ + examples/ragtime/ allow-list precedent.
!examples/generative/
!examples/generative/**
!examples/generative/**/*.flow
!examples/generative/**/*.md
!examples/sections/
!examples/sections/**
!examples/sections/**/*.flow
!examples/sections/**/*.md

# Same Phase 34 D-502 defensive enforcement applied to the Phase 36 example
# folders — rendered WAV/MIDI/MP3 should NEVER land inside the tracked
# tutorial-chapter directories. Composer's intended writeWav target is
# `/tmp/` per the test harness convention.
examples/generative/*.wav
examples/generative/*.mp3
examples/generative/*.mid
examples/sections/*.wav
examples/sections/*.mp3
examples/sections/*.mid

# Phase 37 Plan 37-07 — composer-facing tutorial chapters for granular
# synthesis (examples/dsp/granular.flow) + time-stretch / pitch-shift
# (examples/dsp/stretch_pitchshift.flow). Mirrors the Phase 36 36-12
# examples/{generative,sections}/ allow-list precedent. Same defensive
# D-502 enforcement: rendered .wav / .mp3 / .mid output goes to /tmp/
# per the test harness convention, NEVER inside examples/dsp/.
!examples/dsp/
!examples/dsp/**
!examples/dsp/**/*.flow
!examples/dsp/**/*.md
examples/dsp/*.wav
examples/dsp/*.mp3
examples/dsp/*.mid

# Phase 34 Plan 34-06 D-502 defensive enforcement: the !examples/{symphony,ragtime}/**
# allow-list above re-includes EVERYTHING under those directories, which silently
# defeats the global *.wav ignore for rendered audio. Composer's rendered showcase
# output goes to examples/output/ (already covered) -- but composers running
# `flow render examples/symphony/symphony.flow` with default output paths can
# accidentally drop a multi-MB .wav into examples/symphony/. These explicit
# ignores prevent that footgun. MP3 + MIDI variants also covered for safety.
examples/symphony/*.wav
examples/symphony/*.mp3
examples/symphony/*.mid
examples/ragtime/*.wav
examples/ragtime/*.mp3
examples/ragtime/*.mid

# Phase 28 polyphony / articulation acceptance fixtures — must be tracked
# despite the global *.flow ignore. Pinned by RagtimeFixtureTests.
!examples/tests/
!examples/tests/**
!examples/tests/**/*.flow

# Phase 30 flow-cli scaffold templates — embedded as resources by flow-cli.csproj
# and emitted to disk by `flow new`. Must be tracked despite the global *.flow ignore.
!flow-cli/Scaffold/
!flow-cli/Scaffold/**
!flow-cli/Scaffold/**/*.flow

# Phase 30 MIDI round-trip fixture sources (CC0) — hand-authored .flow files
# whose matching .mid binaries are the regression targets for SPEC-6
# (Midi2FlowRoundTripTests). Must be tracked despite global *.flow ignore.
!flow-lang.Tests/Fixtures/midi/
!flow-lang.Tests/Fixtures/midi/**
!flow-lang.Tests/Fixtures/midi/**/*.flow

# Phase 28 RMS regression baselines (committed reference WAVs used by
# RmsRegressionTests.AssertRmsWithinTolerance) — must be tracked despite
# the global *.wav ignore. The dither RNG is seeded deterministically
# (Phase 15 Plan 05) so two consecutive writes produce byte-identical
# baselines, and the committed file IS the regression pin.
!flow-lang.Tests/baselines/
!flow-lang.Tests/baselines/**
!flow-lang.Tests/baselines/**/*.wav
!flow-lang.Tests/baselines/**/*.mid

# Phase 29 bundled instrument sample library (CC-BY 4.0, University of Iowa
# MIS) — 21 WAVs across 6 instrument subdirectories must be tracked despite
# the global *.wav ignore. Per-instrument LICENSE.md + bundle-wide CREDITS.md
# document attribution. Total bundle ≤ 5 MB.
!flow-lang/Samples/
!flow-lang/Samples/**
!flow-lang/Samples/**/*.wav
!flow-lang/Samples/**/*.md

# Phase 29 Plan 02 unit-test WAV fixtures (programmatically generated tiny
# samples, ≤ 100 KB each) — must be tracked despite the global *.wav ignore.
# SampleCacheTests / SampledInstrumentSmokeTests use these when the full
# bundle is not necessary for the assertion under test.
!flow-lang.Tests/Fixtures/Phase29/
!flow-lang.Tests/Fixtures/Phase29/**
!flow-lang.Tests/Fixtures/Phase29/**/*.wav

# Phase 37 Plan 37-04 PIANO-01 RMS regression fixture — small bundled-piano
# .flow render that exercises the 4-way velocity crossfade + release= knob.
# Must be tracked despite the global *.flow ignore. Mirrors the Phase 29 /
# Phase 30 fixture-tracking precedents.
!flow-lang.Tests/Fixtures/Phase37/
!flow-lang.Tests/Fixtures/Phase37/**
!flow-lang.Tests/Fixtures/Phase37/**/*.flow

# Phase 32 Scala tuning archive fixtures — 5 canonical .scl + 3 hand-authored
# malformed fixtures + LICENSE.md attribution. The LICENSE.md must be tracked
# despite the global *.md ignore; mirrors the Phase 29 Samples precedent above.
!flow-lang.Tests/fixtures/scala/
!flow-lang.Tests/fixtures/scala/**
!flow-lang.Tests/fixtures/scala/**/*.md

# Phase 33 SFZ smoke fixture (synthetic, < 100 KB total per SPEC-7) — 2-region
# .sfz + 2 sine-burst .wav + LICENSE.md must be tracked despite the global
# *.wav and *.md ignores. Regenerable via Phase33FixtureGenerator; size cap
# enforced by Phase33.RepoSizeTests. Mirrors the Phase 29 / 32 precedents.
!flow-lang.Tests/fixtures/sfz-smoke/
!flow-lang.Tests/fixtures/sfz-smoke/**
!flow-lang.Tests/fixtures/sfz-smoke/**/*.wav
!flow-lang.Tests/fixtures/sfz-smoke/**/*.md

# Phase 33 SFZ stdlib module (flow-lang/sfz.flow) — opt-in @sfz surface that
# composers import via `use "@sfz"`. Must be tracked despite the global *.flow
# ignore. Mirrors the existing flow-lang/audio.flow / notation.flow / std.flow
# precedent — those were committed before the global *.flow ignore was added
# (so they remained tracked), but sfz.flow is new and needs an explicit
# allow-list entry to escape the ignore.
!flow-lang/sfz.flow

# Phase 36 Plan 36-11 @improv stdlib module + the 3 baseline rule packs
# under flow-lang/improv/styles/. Same precedent as sfz.flow above —
# new shipped composer surface that escapes the global *.flow ignore.
!flow-lang/improv.flow
!flow-lang/improv/
!flow-lang/improv/**
!flow-lang/improv/**/*.flow

# Phase 39 D-39-01 @notation-io stdlib module — opt-in surface that
# composers import via `use "@notation-io"`. Same precedent as sfz.flow /
# improv.flow above. Distinct from existing flow-lang/notation.flow
# (musical-notation primitives — auto-tracked because added pre-global-ignore).
!flow-lang/notation-io.flow

# Phase 39 D-39-22 — composer-facing tutorial chapters for notation IO
# (writeMusicXML / writeLilyPond / abc / mml). Mirrors examples/symphony/
# + examples/ragtime/ + examples/generative/ allow-list precedents.
!examples/notation/
!examples/notation/**
!examples/notation/**/*.flow
!examples/notation/**/*.md

# Phase 34 D-502 defensive enforcement applied to examples/notation/ — the
# allow-list above re-includes EVERYTHING under that directory. Rendered audio
# from `flow render` calls (composer accidentally drops a multi-MB .wav into the
# tutorial directory) should NEVER land in-tree. examples/notation/output/ is
# the intended write target; we explicitly re-ignore the WAV/MIDI/MP3 there too
# but allow the .musicxml + .ly emit which is small + intentional.
examples/notation/*.wav
examples/notation/*.mp3
examples/notation/*.mid
examples/notation/output/*.wav
examples/notation/output/*.mp3
examples/notation/output/*.mid
examples/notation/output/*.musicxml
examples/notation/output/*.ly

# Phase 39 D-39-22 — composer-facing test_notation_*_example.flow regression
# tests under tests/. The global `tests/` ignore can't be bypassed via
# allow-list because gitignore docs say "it is not possible to re-include a
# file if a parent directory of that file is excluded". The 4 Phase 39
# composer test files were added via `git add -f` (matching the same posture
# under which the existing tracked tests/*.flow files coexist with the
# global tests/ ignore — they were committed before the ignore was added).
# Future Phase 39 maintenance: edit these in place (git tracks them once
# committed); `git add -f` if files need to be re-staged after a clean rebuild.

# Editor-setup documentation (docs/editor-setup/) is user-facing prose and
# MUST be tracked even though *.md is globally ignored above. Raw snippets
# (.lua, .toml) are not matched by the globs, so they track automatically.
!docs/
!docs/**
!docs/**/*.md
!README.md
!CONTRIBUTING.md
!FEATURES.md
midi-to-wav.sh
.claude/worktrees/
