Note: bench_notestream.flow
Note: Hot path measured: NoteStreamCompiler + MusicalContext lookups.
Note: A 16-note literal stream is compiled R times under an active tempo/timesig.
Note: Tuned iteration count: R = 150000 (5000=0.67s -> 30000=1.04s -> 60000=1.09s -> 150k~=2s target).
Note: The 30k->60k bump barely moved wall-clock, suggesting proc-call dispatch dominates over
Note: notestream compile itself; 150k gives clean signal headroom anyway.

use "@std"

tempo 120 {
    timesig 4/4 {

        proc compileBar ()
            Note: Compiling the 16-note literal IS the cost we measure; the proc returns
            Note: 1 so the outer reduce can sum iterations as a sanity check. The variable
            Note: 's' must be bound (not just expression-statement'd) so NoteStreamCompiler
            Note: actually walks the literal against the active MusicalContext stack.
            Sequence s = | C4 D4 E4 F4 G4 A4 B4 C5 D5 E5 F5 G5 A5 B5 C6 D6 |
            1
        end proc

        Int R = 150000

        Int total = (reduce (range 0 R) 0 (fn Int acc, Int i => (add acc (compileBar))))

        (print (concat "total=" (str total)))
        (print "bench_notestream: PASSED")
    }
}
