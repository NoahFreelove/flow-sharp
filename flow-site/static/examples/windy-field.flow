// "Windy Field" — an ambient soundscape built entirely from buffer DSP.
// Nothing here is a sampled instrument: every sound is white noise or an
// oscillator, shaped by filters, envelopes, reverb, delay and panning.
//
// This version is threaded together with Flow's `->` flow operator, the
// language's signature move: `x -> (f a b)` is just sugar for `(f x a b)`, so a
// signal chain reads top-to-bottom (source first, effects after) instead of
// inside-out. `fadeIn`/`fadeOut` mutate their buffer in place, so they stay as
// their own statements between the chains.
use "@std"
use "@audio"
use "@composition"

tempo 90 {
  key Cmajor {

    // ---- 1. The wind bed: filtered white noise that breathes ----
    // Read the chain aloud: take noise, lowpass it, highpass it, drop its gain.
    Buffer windBed = ((noise 16.0 0.55 2)
      -> (lowpass 650.0)
      -> (highpass 140.0)
      -> (gain -6dB))
    (fadeIn windBed 4.0)
    (fadeOut windBed 4.0)

    // ---- 2. A gust: a brighter band of noise, swelled and panned ----
    Buffer gustBand = ((noise 5.0 0.7 2) -> (bandpass 300.0 1800.0))
    (fadeIn gustBand 2.0)
    (fadeOut gustBand 2.5)
    Buffer gustWide = (gustBand -> (pan 0.4))
    // Silence -> append gust -> append tail: place the gust 5s in with room after.
    Buffer gust1    = ((createSilence 5.0)
      -> (appendBuffers gustWide)
      -> (appendBuffers (createSilence 6.0)))

    // ---- 3. Rustling grass: two soft bandpass-noise surges that ebb and flow ----
    // Bright "shhh" noise — continuous, no discrete grains — that swells in and out
    // and drifts across the field as the wind moves through the blades.
    Buffer rustleA  = ((noise 9.0 0.5 2) -> (bandpass 1800.0 6500.0))
    (fadeIn rustleA 2.5)
    (fadeOut rustleA 3.0)
    Buffer surgeA   = ((createSilence 1.0)
      -> (appendBuffers (rustleA -> (pan 0.3)))
      -> (appendBuffers (createSilence 6.0)))
    Buffer rustleB  = ((noise 8.0 0.5 2) -> (bandpass 1500.0 5500.0))
    (fadeIn rustleB 2.5)
    (fadeOut rustleB 2.5)
    Buffer surgeB   = ((createSilence 7.0) -> (appendBuffers (rustleB -> (pan (neg 0.3)))))
    Buffer grassMix = ((mix surgeA surgeB) -> (volume 0.2))

    // ---- 4. A distant bird: a note-stream motif, then pushed far away ----
    section call {
      Sequence motif = | _ q G5e B5e G5e _ q E5h |
    }
    Song birdSong   = [call]
    // Render the motif on the triangle synth, then soften/echo/reverb/pan it away.
    Buffer birdFar  = (birdSong
      -> (renderSong "triangle")
      -> (lowpass 2600.0)
      -> (delay 380.0 0.45 0.5)
      -> (reverb 0.8 0.4 0.6)
      -> (pan (neg 0.5)))
    Buffer bird1    = ((createSilence 7.0) -> (appendBuffers birdFar))

    // ---- 5. Mix the layers down and glue with a master reverb ----
    // Start from the wind bed and fold each layer in, then wet + lift the whole mix.
    Buffer master = (windBed
      -> (mix gust1)
      -> (mix grassMix)
      -> (mix bird1)
      -> (reverb 0.3 0.5 0.25)
      -> (gain 6dB))

    (play master)
  }
}
