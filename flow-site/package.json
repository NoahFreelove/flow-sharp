{
	"name": "flow-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"sync:wiki": "bash scripts/sync-wiki.sh",
		"predev": "bash scripts/sync-wiki.sh",
		"textures": "node scripts/optimize-textures.mjs",
		"prebuild": "bash scripts/sync-wiki.sh && node scripts/optimize-textures.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"lh": "lhci autorun",
		"lh:serve": "node scripts/lh-serve.mjs",
		"lh:audit": "LHCI_FORM_FACTOR=mobile lhci autorun && LHCI_FORM_FACTOR=desktop lhci autorun"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.11.3",
		"@fontsource/fraunces": "5.2.9",
		"@fontsource/inter": "5.2.8",
		"@fontsource/jetbrains-mono": "5.2.8",
		"@lhci/cli": "0.15.1",
		"@playwright/test": "1.60.0",
		"@sveltejs/adapter-cloudflare": "7.2.8",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "4.3.0",
		"@testing-library/svelte": "5.3.1",
		"jsdom": "^29.1.1",
		"mdsvex": "0.12.7",
		"rehype-slug": "^6.0.0",
		"sharp": "0.34.5",
		"shiki": "4.2.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "4.3.0",
		"typescript": "^6.0.2",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.0.7",
		"vitest": "4.1.8"
	},
	"dependencies": {
		"fflate": "0.8.3",
		"monaco-editor": "0.55.1"
	}
}
